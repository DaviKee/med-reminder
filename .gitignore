# ===== Dependencies =====
node_modules/

# ===== Android build artifacts =====
android/.gradle/
android/app/build/
android/build/
android/local.properties
android/**/*.iml
android/.idea/

# ===== iOS (future-proof; not present yet) =====
ios/

# ===== Capacitor / native build outputs =====
*.apk
*.aab
*.keystore
*.jks

# ===== Logs & OS cruft =====
*.log
.DS_Store
Thumbs.db
desktop.ini

# ===== WorkBuddy / editor internal =====
.workbuddy/
.vscode/*
!.vscode/extensions.json

# ===== 开发期临时脚本 / 中间产物 =====
# 调试时会在根目录写 _ta.js / _tn.js / _ab.json 这类脚本，跑完就该删。
# 2026-09-21 有一次清理没跑成，结果被 `git add -A` 误提交（aeee498）——
# 加这条规则兜底，避免再犯。
_*.js
_*.py
_*.json
_*.md

# ===== harness 自检的临时备份（selftest_e2e.py 用，正常 finally 会删） =====
*.selftest-bak

# ===== Python 字节码缓存（跑 harness 时产生） =====
__pycache__/

# ===== S-0 鸿蒙 spike 的产物（HAP、鸿蒙原生工程、签名文件） =====
# spike 是试验性质，结论出来之前不把鸿蒙原生工程纳入版本库。
# 见 MedReminder-后续任务计划.md §24。
/spike/openharmony/
/spike/harmony/
*.hap
*.har
*.hsp

# 模拟器截图（运行时产物，会越积越多）
/spike/shots/

# AGC 截图采集的临时目录（spike/agc-shots/capture.py 会自动重建）
/spike/harmony-test/screenshots-for-agc/_tmp/

# ===== S-0 最小测试工程：依赖与生成的鸿蒙原生工程不入库 =====
# 但 package.json / capacitor.config.json / www/ 要入库 —— 它们是可复现的 spike 产物
/spike/harmony-test/node_modules/
/spike/harmony-test/openharmony/
/spike/harmony-test/oh-plugins/
/spike/harmony-test/.hvigor/
/spike/harmony-test/build/
/spike/harmony-test/oh_modules/
# oh-plugins/ 是 hionic 从 @capacitor-ohos/* 复制的**第三方（华为）源码**，
# 不该进我们的版本库 —— 用 `hionic plugin add` 随时能重建。
